{
  "name": "bae-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "tsc --build tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "download"
    }
  },
  "private": true,
  "imports": {
    "#core/*": "./src/app/core/*",
    "#shared/*": "./src/app/shared/*",
    "#pages/*": "./src/app/pages/*",
    "#app/*": "./src/app/*"
  },
  "dependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@floating-ui/dom": "^1.8.0",
    "@lucide/angular": "^1.28.0",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/signals": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "date-fns": "^4.4.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
